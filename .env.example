# Gemini Flash is used for the AI summary when this key is set.
# Get a key in Google AI Studio, then put it in .env.local (never commit it).
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Without GEMINI_API_KEY, the app still works with rule-based analysis only.

# Future monetization / accounts (not required for the MVP)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# STRIPE_SECRET_KEY=
# NEXTAUTH_SECRET=
# DATABASE_URL=
