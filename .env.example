# Gemini is used for the AI summary when this key is set.
# Get a key in Google AI Studio, then put it in .env.local (never commit it).
# On Cloudflare: `npx wrangler secret put GEMINI_API_KEY`
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite (see docs/AI_COST.md).
# GEMINI_MODEL=gemini-3.8-flash

# Optional. Maximum AI summaries per day (JST). Defaults to 300.
# AI_DAILY_LIMIT=300

# Without GEMINI_API_KEY, the app still works with rule-based analysis only.
# Bind a Cloudflare KV namespace as REPORT_CACHE to cache summaries and
# enforce AI_DAILY_LIMIT across instances (see docs/AI_COST.md).
